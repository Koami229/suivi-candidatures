# ============================================================
# Suivi des candidatures — variables d'environnement
# Copier en .env pour le travail local ; sur Vercel, définir
# dans Dashboard → Project → Settings → Environment Variables.
# Ne JAMAIS committer le .env.
# ============================================================

# --- Base de données ---
# Sur Vercel : créée via Dashboard → Storage → Vercel Postgres
# (DATABASE_URL est injectée automatiquement, par environnement).
DATABASE_URL=

# --- Chiffrement des clés API email stockées en base (étape 5) ---
# Clé de chiffrement AES-256-GCM des clés API que l'admin colle
# dans Paramètres > Email. Générer : openssl rand -hex 32
# Obligatoire dès que l'admin enregistre une clé API.
EMAIL_API_KEY_ENC=

# --- Authentification (étape 2) ---
# Secret JWT (HS256). Générer : openssl rand -base64 48
JWT_SECRET=
# URL publique de l'app (liens d'activation, emails)
APP_URL=https://votre-projet.vercel.app

# --- Géocodage (étape 6) ---
# REMPLACER par VOTRE clé Geoapify : la clé présente dans l'ancien
# fichier HTML doit être considérée comme divulguée et RÉVOQUÉE.
GEOAPIFY_API_KEY=

# --- Bootstrap de l'admin (une seule fois, puis RETIRER de Vercel) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NOM=
ADMIN_BOOTSTRAP_PRENOM=
